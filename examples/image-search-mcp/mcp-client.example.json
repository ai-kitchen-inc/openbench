{
  "servers": {
    "image_search": {
      "command": "python",
      "args": [
        "-m",
        "app.mcp_server",
        "--transport",
        "stdio"
      ],
      "cwd": "examples/image-search-mcp",
      "type": "stdio",
      "env": {
        "DATA_PATH": "examples/image-search-mcp/data",
        "INDEX_PATH": "examples/image-search-mcp/data/index",
        "MODEL_CACHE_PATH": "examples/image-search-mcp/models"
      }
    }
  }
}
