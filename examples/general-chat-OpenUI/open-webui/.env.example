OPEN_WEBUI_PORT=3000
WEBUI_AUTH=false

# Docker Desktop can reach a host-side backend through host.docker.internal.
# If the backend runs somewhere else, point this to that /v1 base URL.
GENERAL_CHAT_OPENAI_BASE_URL=http://host.docker.internal:8005/v1
GENERAL_CHAT_OPENAI_API_KEY=not-needed
GENERAL_CHAT_OPENAI_MODEL_ID=general-chat
