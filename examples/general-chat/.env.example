# ── Required ──────────────────────────────────────────────────────────────────
# Get a key at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
TAVILY_API_KEY=

# ── Model (optional) ──────────────────────────────────────────────────────────
GENERAL_CHAT_MODEL=gemini-2.5-flash

# Vision-language model for uploaded images (enabled by default)
# Options:
# - gemini-2.5-flash (default, uses GOOGLE_API_KEY or GEMINI_API_KEY)
# - gemma-2b        (Ollama model: gemma4:e2b)
# - gemma-4b        (Ollama model: gemma4:e4b)
GENERAL_CHAT_VLM_ENABLED=1
GENERAL_CHAT_VLM_MODEL=gemini-2.5-flash
# GENERAL_CHAT_VLM_PROVIDER=gemini
# GENERAL_CHAT_VLM_PROVIDER=ollama
# GENERAL_CHAT_VLM_BASE_URL=http://localhost:11434/v1
# GENERAL_CHAT_VLM_TEMPERATURE=0.2
# GENERAL_CHAT_VLM_MAX_OUTPUT_TOKENS=2048

# ── Storage paths (optional, relative to examples/general-chat/) ──────────────
# GENERAL_CHAT_UPLOAD_DIR=uploads
# GENERAL_CHAT_DOWNLOAD_DIR=downloads
# GENERAL_CHAT_STORAGE_ROOT=.openbench
# GENERAL_CHAT_MEMORY_DB=general_chat_memory.db

# Search provider (optional; defaults to Tavily)
# GENERAL_CHAT_DISCOVERY_PROVIDER=tavily
# GENERAL_CHAT_DISCOVERY_PROVIDERS=tavily

# ── Source size limit (optional, bytes) ───────────────────────────────────────
# GENERAL_CHAT_MAX_SOURCE_BYTES=26214400

# Dashboard generator / Stitch (optional)
# DASHBOARD_RENDER_ADAPTER=auto
# OPENBENCH_DASHBOARD_STATE_PATH=.openbench/dashboard_generator_state.json
# STITCH_API_KEY=
# STITCH_API_URL=
# STITCH_API_MODE=mcp
# STITCH_PROJECT_ID=

# Grafana deploy (optional; the Deploy button returns 503 without these).
# Requires a reachable Grafana instance. The http://grafana:3000 default only
# resolves inside the deployed docker network — for local dev run Grafana
# (e.g. docker run -p 3000:3000 grafana/grafana) and use localhost.
# GRAFANA_URL=http://localhost:3000
# GRAFANA_PUBLIC_URL=http://localhost:3000
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=

# ── Auth (keep 1 for local dev) ───────────────────────────────────────────────
OPENBENCH_AUTH_DISABLED=1
# Local dev only (auth disabled): start the UI as a plain "user" account
# instead of admin. Also switchable per request via the X-Local-Role header
# and the "Lihat sebagai Pengguna" button in the admin sidebar.
# GENERAL_CHAT_LOCAL_ROLE=user

# MCP testing (optional; disabled by default)
GENERAL_CHAT_MCP_ENABLED=0
GENERAL_CHAT_MCP_MODE=local
GENERAL_CHAT_MCP_CONFIG=mcp/openbench-mcp.yaml
GENERAL_CHAT_MCP_APPROVED_TOOLS=openbench.filter_records,openbench.distinct_values,openbench.group_and_aggregate,openbench.top_n_records,openbench.fetch_url
# Set to 0 for dedicated single-server demo scripts so saved MCP registry entries are ignored.
# GENERAL_CHAT_MCP_REGISTRY_ENABLED=1

# Real external MCP server demo (official filesystem MCP server)
# GENERAL_CHAT_MCP_SANDBOX=mcp-sandbox
# GENERAL_CHAT_MCP_MODE=external
# GENERAL_CHAT_MCP_CONFIG=mcp/filesystem-mcp.yaml
# GENERAL_CHAT_MCP_APPROVED_TOOLS=filesystem.list_allowed_directories,filesystem.list_directory,filesystem.read_text_file,filesystem.read_file,filesystem.get_file_info

# Image search MCP demo (Dockerized DINOv3 + CIFAR-10 server)
# Prefer scripts/run_with_image_search_mcp.ps1, which sets absolute paths automatically.
# GENERAL_CHAT_MCP_ENABLED=1
# GENERAL_CHAT_MCP_MODE=external
# GENERAL_CHAT_MCP_CONFIG=mcp/image-search-docker.yaml
# GENERAL_CHAT_MCP_APPROVED_TOOLS=image_search.list_index_stats,image_search.index_images,image_search.search_similar_images,image_search.rebuild_index
# GENERAL_CHAT_MCP_REGISTRY_ENABLED=0
# IMAGE_SEARCH_MCP_DATA_PATH=C:/Users/Admin/Desktop/openbench/examples/image-search-mcp/data
# IMAGE_SEARCH_MCP_MODELS_PATH=C:/Users/Admin/Desktop/openbench/examples/image-search-mcp/models
# IMAGE_SEARCH_MCP_UPLOADS_PATH=C:/Users/Admin/Desktop/openbench/examples/general-chat/uploads
# IMAGE_SEARCH_MCP_HF_CACHE_PATH=C:/Users/Admin/.cache/huggingface
# GENERAL_CHAT_IMAGE_SEARCH_PREVIEW_DIR=C:/Users/Admin/Desktop/openbench/examples/image-search-mcp/data/previews

# Custom functions sandbox (Functions panel test runs + custom_function MCP)
# Local dev: build the image once, then point CUSTOM_FN_IMAGE at it:
#   docker build -t custom-function-mcp:local mcp/custom-function-mcp   (from repo root)
# Unset, it defaults to the Artifact Registry image used on the deployed VM.
# CUSTOM_FN_IMAGE=custom-function-mcp:local
# CUSTOM_FN_DATA_PATH=.openbench/custom-functions

# SAM 3 concept counting MCP demo (Dockerized Ultralytics SAM 3)
# Prefer scripts/run_with_sam_segmentation_mcp.ps1, which sets absolute paths automatically.
# Build the SAM image with examples/sam-segmentation-mcp/weights/sam3.pt or HF_TOKEN first.
# GENERAL_CHAT_MCP_ENABLED=1
# GENERAL_CHAT_MCP_MODE=external
# GENERAL_CHAT_MCP_CONFIG=mcp/sam-segmentation-docker.yaml
# GENERAL_CHAT_MCP_APPROVED_TOOLS=sam_segmentation.count_objects_with_sam3
# GENERAL_CHAT_MCP_REGISTRY_ENABLED=0
# SAM_SEGMENTATION_MCP_UPLOADS_PATH=C:/Users/Admin/Desktop/openbench/examples/general-chat/uploads
# HF_TOKEN=hf_...
# SAM3_PREINSTALL=required
