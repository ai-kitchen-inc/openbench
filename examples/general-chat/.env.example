# ── Required ──────────────────────────────────────────────────────────────────
# Get a key at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
TAVILY_API_KEY=

# ── Model (optional) ──────────────────────────────────────────────────────────
GENERAL_CHAT_MODEL=gemini-2.5-flash

# ── Storage paths (optional, relative to examples/general-chat/) ──────────────
# GENERAL_CHAT_UPLOAD_DIR=uploads
# GENERAL_CHAT_DOWNLOAD_DIR=downloads
# GENERAL_CHAT_STORAGE_ROOT=.openbench
# GENERAL_CHAT_MEMORY_DB=general_chat_memory.db

# Search provider (optional; defaults to Tavily)
# GENERAL_CHAT_DISCOVERY_PROVIDER=tavily
# GENERAL_CHAT_DISCOVERY_PROVIDERS=tavily

# ── Source size limit (optional, bytes) ───────────────────────────────────────
# GENERAL_CHAT_MAX_SOURCE_BYTES=26214400

# ── Auth (keep 1 for local dev) ───────────────────────────────────────────────
OPENBENCH_AUTH_DISABLED=1

# MCP testing (optional; disabled by default)
GENERAL_CHAT_MCP_ENABLED=0
GENERAL_CHAT_MCP_MODE=local
GENERAL_CHAT_MCP_CONFIG=mcp/openbench-mcp.yaml
GENERAL_CHAT_MCP_APPROVED_TOOLS=openbench.filter_records,openbench.distinct_values,openbench.group_and_aggregate,openbench.top_n_records

# Real external MCP server demo (official filesystem MCP server)
# GENERAL_CHAT_MCP_SANDBOX=mcp-sandbox
# GENERAL_CHAT_MCP_MODE=external
# GENERAL_CHAT_MCP_CONFIG=mcp/filesystem-mcp.yaml
# GENERAL_CHAT_MCP_APPROVED_TOOLS=filesystem.list_allowed_directories,filesystem.list_directory,filesystem.read_text_file,filesystem.read_file,filesystem.get_file_info

# Image search MCP demo (Dockerized DINOv3 + CIFAR-10 server)
# Prefer scripts/run_with_image_search_mcp.ps1, which sets absolute paths automatically.
# GENERAL_CHAT_MCP_ENABLED=1
# GENERAL_CHAT_MCP_MODE=external
# GENERAL_CHAT_MCP_CONFIG=mcp/image-search-docker.yaml
# GENERAL_CHAT_MCP_APPROVED_TOOLS=image_search.list_index_stats,image_search.index_images,image_search.search_similar_images,image_search.rebuild_index
# IMAGE_SEARCH_MCP_DATA_PATH=C:/Users/Admin/Desktop/openbench/examples/image-search-mcp/data
# IMAGE_SEARCH_MCP_MODELS_PATH=C:/Users/Admin/Desktop/openbench/examples/image-search-mcp/models
# IMAGE_SEARCH_MCP_UPLOADS_PATH=C:/Users/Admin/Desktop/openbench/examples/general-chat/uploads
# IMAGE_SEARCH_MCP_HF_CACHE_PATH=C:/Users/Admin/.cache/huggingface
# GENERAL_CHAT_IMAGE_SEARCH_PREVIEW_DIR=C:/Users/Admin/Desktop/openbench/examples/image-search-mcp/data/previews
