# Dashboard Chat — local dev configuration.
# Copy to .env and fill in. If GOOGLE_API_KEY is empty, the server falls
# back to the sibling examples/general-chat/.env value when present.

GOOGLE_API_KEY=

# Gemini model for the dashboard copilot.
DASHBOARD_CHAT_MODEL=gemini-2.5-flash

# Built-in account passwords (local auth).
DASHBOARD_CHAT_ADMIN_PASSWORD=admin123
DASHBOARD_CHAT_GUEST_PASSWORD=guest123

# Hard cap on rows returned per chart query.
DASHBOARD_CHAT_MAX_ROWS=5000
