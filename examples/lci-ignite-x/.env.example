# Google Gemini API
GOOGLE_API_KEY=your-google-api-key

# Pinecone (for PROPER 2025 RAG)
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=lci-ignite

# LCI Ignite X settings
LCI_MODEL=gemini-2.5-flash
LCI_TEMPERATURE=0.3
LCI_MEMORY_DB=lci_memory.db
LCI_UPLOAD_DIR=./uploads
PINECONE_NAMESPACE=proper-2025
LCI_EMBEDDING_MODEL=text-embedding-004
