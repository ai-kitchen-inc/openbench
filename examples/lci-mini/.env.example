# Google Gemini API key — required for the demo
GOOGLE_API_KEY=your-google-api-key-here


# ── Storage backend (optional) ──────────────────────────────────────
#
# By default, lci-mini persists ChatSessions and scratchpad memory on the
# local filesystem under examples/lci-mini/.openbench/. The storage backend
# is agnostic — set the Drive env vars below to move everything to a
# Google Drive folder instead.

# Override local storage root (default: examples/lci-mini/.openbench/)
# LCI_MINI_STORAGE_ROOT=/absolute/path/to/.openbench

# ── Google Drive backend ──
# Uncomment both to route sessions + scratchpad through a Drive folder.
# The service account must have Editor access on the folder.
# LCI_MINI_DRIVE_ROOT=1ABCdefGhiJklMnoPqrStuVwxYz
# LCI_MINI_SERVICE_ACCOUNT=/secrets/lci-mini-storage.json


# ── Authentication (Firebase) ────────────────────────────────────────
# Optional. Two mutually-exclusive modes:
#
#   (a) Dev bypass — skip auth entirely, dependency returns a synthetic
#       dev user. DO NOT set in production.
#
#         OPENBENCH_AUTH_DISABLED=1
#
#   (b) Firebase mode — verify every request's Bearer ID token with the
#       Firebase Admin SDK. FIREBASE_ADMIN_CREDENTIALS is optional —
#       leave it unset when running on Cloud Run / GKE to fall back to
#       Application Default Credentials.
#
#         FIREBASE_PROJECT_ID=your-firebase-project
#         FIREBASE_ADMIN_CREDENTIALS=/secrets/firebase-admin.json
#
# If neither is set, the dependency returns an anonymous synthetic user
# — matches the pre-auth behavior, which is what the service-account
# storage deployments rely on.


# ── Frontend Firebase Auth (VITE_* only) ─────────────────────────────
# Optional. When these are set, the frontend requires sign-in before
# chat; unset means anonymous (preserves today's behavior).
# Copy values from Firebase Console → Project Settings → Your apps →
# SDK setup and configuration.
#
# VITE_FIREBASE_API_KEY=AIza...
# VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your-project
# VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef
# VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
# VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com


# ── Drive OAuth (per-user Drive storage via user consent) ────────────
# Optional. Only needed if you want signed-in users to click "Connect
# Drive" and store their own sessions/scratchpads under their own
# Google Drive account (distinct from the service-account backend
# above, which uses one shared folder for everyone).
#
# Create a Web OAuth client in Google Cloud Console → APIs & Services
# → Credentials, then download the JSON and point to it here. The
# redirect URL must EXACTLY match the one you register in the console.
#
# GOOGLE_OAUTH_CLIENT_SECRETS=/secrets/drive-oauth-client.json
# DRIVE_OAUTH_REDIRECT_URL=https://lci-mini.example.com/auth/drive/callback
#
# SESSION_SECRET signs the state cookie used during the OAuth round-trip.
# Set to a long random string (openssl rand -base64 32).
#
# SESSION_SECRET=replace-with-32-bytes-base64


# ── Refresh-token encryption (recommended) ───────────────────────────
# Optional but strongly recommended for production. Base64-encoded
# 32-byte key passed to AES-GCM. When unset, refresh tokens are stored
# in plaintext — fine for localhost, NOT fine for prod.
#
#     openssl rand -base64 32
#
# DRIVE_TOKEN_ENCRYPTION_KEY=replace-with-32-bytes-base64


# ── Other optional overrides ─────────────────────────────────────────
# LCI_MINI_MEMORY_DB=lci_mini_memory.db
# LCI_MINI_UPLOAD_DIR=/absolute/path/to/uploads
# LCI_MINI_DOWNLOAD_DIR=/absolute/path/to/downloads
# OPENBENCH_PROFILE_DIR=/absolute/path/to/profiles
