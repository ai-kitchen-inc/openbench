# Gemini API key for the chat agent. Optional here: when unset, server.py
# falls back to the sibling general-chat example's .env (API keys only).
GOOGLE_API_KEY=

# Optional: override the demo credentials (defaults: admin123 / guest123).
# CONTROLLED_CHAT_ADMIN_PASSWORD=
# CONTROLLED_CHAT_GUEST_PASSWORD=

# Optional: fixed token-signing secret. When unset, one is generated and
# persisted under .openbench/controlled-auth-secret.txt.
# CONTROLLED_CHAT_AUTH_SECRET=

# Optional: model override (default: gemini-3-flash-preview).
# GENERAL_CHAT_MODEL=gemini-2.5-flash
