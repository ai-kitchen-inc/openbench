{
  "name": "@openbench/chat-ui",
  "version": "0.1.0",
  "description": "React component library for rendering interactive chat interfaces powered by A2UI v0.10 JSONL",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./styles/chat-ui.css": "./styles/chat-ui.css",
    "./styles/bundle.css": "./dist/index.css"
  },
  "files": [
    "dist",
    "styles"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@ag-ui/client": "^1.0.4",
    "@ag-ui/core": "^1.0.4",
    "katex": "0.18.10",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^3.23.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "jsdom": "^25.0.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@10.33.3",
  "pnpm": {
    "overrides": {
      "katex": "$katex",
      "minimatch": "^11.0.9"
    }
  },
  "keywords": [
    "react",
    "chat",
    "a2ui",
    "openbench",
    "ui",
    "streaming"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ai-kitchen-inc/openbench",
    "directory": "studio/chat-ui"
  }
}
