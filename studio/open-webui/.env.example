OPEN_WEBUI_PORT=3000
WEBUI_AUTH=false
ENABLE_OLLAMA_API=false

# Docker Desktop can reach a host-side OpenBench backend through host.docker.internal.
# If the backend runs somewhere else, point this to that /v1 base URL.
OPENBENCH_OPENAI_BASE_URL=http://host.docker.internal:8005/v1
OPENBENCH_OPENAI_API_KEY=not-needed
OPENBENCH_OPENAI_MODEL_ID=openbench-chat
