{
  "permissions": {
    "allow": [
      "Bash(python -m unittest*)",
      "Bash(pytest*)",
      "Bash(pip install*)",
      "Bash(pip list*)",
      "Bash(black*)",
      "Bash(ruff*)",
      "Bash(mypy*)",
      "Bash(python examples/*)",
      "Bash(python -c*)",
      "Read(**)",
      "Write(src/**)",
      "Write(tests/**)",
      "Write(examples/**)",
      "Edit(src/**)",
      "Edit(tests/**)",
      "Edit(examples/**)",
      "Write(docs/**)",
      "Edit(docs/**)"
    ],
    "deny": []
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "code-review-graph update --skip-flows",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "code-review-graph status",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
