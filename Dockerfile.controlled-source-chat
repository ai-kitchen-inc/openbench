# ============================================================
# Controlled Source Chat — single-container image for Cloud Run
# Stage 1 builds the React SPA (served same-origin by the API via
# GENERAL_CHAT_STATIC_DIR); stage 2 is the Python API runtime.
# Build from repo root: docker build -f Dockerfile.controlled-source-chat .
# ============================================================

# ── Stage 1: frontend build ─────────────────────────────────
FROM node:22-slim AS frontend

RUN npm install -g pnpm@10

WORKDIR /build

# Preserve repo layout: the frontend depends on the workspace SDK via
# "file:../../../studio/chat-ui", which must be built (dist/) before the
# frontend install packs it.
COPY studio/chat-ui/ studio/chat-ui/
COPY examples/controlled-source-chat/frontend/ examples/controlled-source-chat/frontend/

RUN cd studio/chat-ui && pnpm install && pnpm build

# No VITE_BACKEND_URL: the SPA uses relative API paths (same-origin).
RUN cd examples/controlled-source-chat/frontend && pnpm install && pnpm build

# ── Stage 2: Python API runtime ─────────────────────────────
FROM python:3.13-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    libcairo2 \
    libglib2.0-0 \
    libgl1 \
    libheif1 \
    libreadline8 \
    libsm6 \
    libxext6 \
    libxrender1 \
    libxcb1 \
    openssl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY . /app

# controlled-source-chat imports the sibling general_chat package by path,
# so both examples must be installed alongside the SDK.
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -e .[google,chat,search,gcp,mcp,epub,media] && \
    pip install --no-cache-dir -e ./examples/general-chat && \
    pip install --no-cache-dir -e ./examples/controlled-source-chat

# No playwright/chromium: dashboard PDF export is not supported in this image.

COPY --from=frontend /build/examples/controlled-source-chat/frontend/dist \
    /app/examples/controlled-source-chat/frontend/dist

ENV GENERAL_CHAT_STATIC_DIR=/app/examples/controlled-source-chat/frontend/dist
ENV PORT=8080

WORKDIR /app/examples/controlled-source-chat

CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8080"]
