# General Chat on Compute Engine + Cloud Storage + Cloud SQL
#
# Copy this file to .env.gcp on the VM and fill in the values.

GOOGLE_API_KEY=
GENERAL_CHAT_MODEL=gemini-3-flash-preview

# Firebase Auth gate for the General Chat API.
# Set GENERAL_CHAT_ALLOWED_EMAILS to the exact users permitted to access the app.
GENERAL_CHAT_FIREBASE_PROJECT_ID=sss-poc1-corporate
GENERAL_CHAT_ALLOWED_EMAILS=admin@example.com
GENERAL_CHAT_ALLOWED_DOMAINS=
GENERAL_CHAT_FIREBASE_CHECK_REVOKED=0
# Comma-separated CORS allowlist. Scope to the Firebase Hosting origins in prod.
GENERAL_CHAT_ALLOWED_ORIGINS=https://sss-poc1-corporate.web.app,https://sss-poc1-corporate.firebaseapp.com

# Cloud Storage direct-upload backend
GENERAL_CHAT_GCP_BUCKET=YOUR_GCS_BUCKET
GENERAL_CHAT_GCP_UPLOADS_PREFIX=uploads
GENERAL_CHAT_GCP_OUTPUTS_PREFIX=outputs
GENERAL_CHAT_GCP_DERIVED_PREFIX=derived
GENERAL_CHAT_GCP_USER_ID=default
GENERAL_CHAT_GCP_CACHE_ROOT=/tmp/openbench-gcs-cache

# Forever-archive: every upload is copied (best-effort) to this DEDICATED,
# standalone bucket under <prefix>/<YYYY-MM-DD>/<file-id>-<name>. Nothing in the
# app ever deletes it. Leave unset to disable archiving. Keep separate from the
# uploads bucket above.
GENERAL_CHAT_ARCHIVE_BUCKET=
GENERAL_CHAT_GCP_ARCHIVE_PREFIX=archive

# Direct uploads use this path for large files. Multipart remains for small files only.
GENERAL_CHAT_MULTIPART_UPLOAD_MAX_BYTES=26214400
GENERAL_CHAT_GCP_MAX_SOURCE_BYTES=262144000
GENERAL_CHAT_GCP_CHUNK_SIZE=1000
GENERAL_CHAT_GCP_CHUNK_OVERLAP=200

# Cloud SQL for PostgreSQL.
# For private IP or Auth Proxy sidecar, use the appropriate host/port visible to the VM.
GENERAL_CHAT_DATABASE_URL=postgresql://openbench:CHANGE_ME@127.0.0.1:5432/openbench

# --- db_server MCP → Cloud SQL (appdata) -------------------------------------
# Cloud SQL instance connection name for the cloud-sql-proxy sidecar
# (project:region:instance). The VM service account needs roles/cloudsql.client.
CLOUD_SQL_INSTANCE=PROJECT:REGION:INSTANCE
# Read/materialize role the db_server MCP uses, reached via the proxy on the
# shared docker network (no sslmode — the proxy encrypts upstream).
MCP_DB_DATABASE_URL=postgresql://mcp_app:CHANGE_ME@cloud-sql-proxy:5432/appdata
# Admin connection used by `deploy.sh init-appdb` / `seed-mcp-db` for DDL + seeding.
APPDATA_ADMIN_URL=postgresql://openbench:CHANGE_ME@cloud-sql-proxy:5432/appdata
# Enable the agent's write/materialize tools (1) or keep read-only (0).
MCP_ALLOW_WRITES=1
# Max rows returned by db_server read queries.
MCP_MAX_ROWS=1000

# Pub/Sub subscription fed by Cloud Storage OBJECT_FINALIZE notifications.
# Use the full subscription path:
# projects/PROJECT_ID/subscriptions/openbench-worker-file-processing
GENERAL_CHAT_GCP_PUBSUB_SUBSCRIPTION=

# Optional runtime defaults. docker-compose.gce.yml already supplies these values.
# Keep them here only when you want to override the Compose defaults.
GENERAL_CHAT_STORAGE_ROOT=/app-data/openbench
GENERAL_CHAT_UPLOAD_DIR=/general-chat/uploads
GENERAL_CHAT_DOWNLOAD_DIR=/general-chat/downloads

# Optional all-MCP defaults. docker-compose.gce.yml already supplies these values.
GENERAL_CHAT_SEED_ALL_MCP=1
GENERAL_CHAT_MCP_SANDBOX=/general-chat/mcp-sandbox
GENERAL_CHAT_IMAGE_SEARCH_CONTAINER_UPLOAD_ROOT=/general-chat/uploads
GENERAL_CHAT_IMAGE_SEARCH_PREVIEW_DIR=/general-chat/image-search/data/previews
IMAGE_SEARCH_MCP_DATA_PATH=/app-data/image-search/data
IMAGE_SEARCH_MCP_MODELS_PATH=/app-data/image-search/models
IMAGE_SEARCH_MCP_UPLOADS_PATH=/app-data/uploads
IMAGE_SEARCH_MCP_HF_CACHE_PATH=/app-data/huggingface
SAM_SEGMENTATION_MCP_UPLOADS_PATH=/app-data/uploads
SAM_SEGMENTATION_MCP_DEBUG_PATH=/app-data/uploads/_sam_debug
OPENBENCH_MCP_DOCKER_PROFILE=openbench

# Dashboard generator MCP. docker-compose.gce.yml already supplies these values.
# The dashboard-generator MCP is seeded into the registry (BUNDLED_MCP_CONFIGS)
# and replaces the in-process SDK dashboard skill.
GENERAL_CHAT_DASHBOARD_SKILL_ENABLED=0
OPENBENCH_EXPORT_DIR=/general-chat/downloads
OPENBENCH_EXPORT_URL_BASE=/downloads
DASHBOARD_RENDER_ADAPTER=default
DASHBOARD_GENERATOR_MCP_PYTHONPATH=/app/src:/app/mcp/dashboard-generator-mcp
DASHBOARD_GENERATOR_MCP_PYTHON=python

OPENBENCH_IMAGE=openbench-general-chat:latest
OPENBENCH_API_PORT=8080
OPENBENCH_API_BIND=127.0.0.1
# The API stays bound to 127.0.0.1:8080. A host nginx terminates TLS on 443
# (Let's Encrypt for <ip-with-dashes>.sslip.io) and reverse-proxies to it.
# See deploy/nginx-openbench-api.conf for the reference server block.
