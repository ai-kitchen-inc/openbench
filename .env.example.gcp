# General Chat on Compute Engine + Cloud Storage + Cloud SQL
#
# Copy this file to .env.gcp on the VM and fill in the values.

GOOGLE_API_KEY=
GENERAL_CHAT_MODEL=gemini-3-flash-preview

# Cloud Storage direct-upload backend
GENERAL_CHAT_GCP_BUCKET=YOUR_GCS_BUCKET
GENERAL_CHAT_GCP_UPLOADS_PREFIX=uploads
GENERAL_CHAT_GCP_OUTPUTS_PREFIX=outputs
GENERAL_CHAT_GCP_DERIVED_PREFIX=derived
GENERAL_CHAT_GCP_USER_ID=default
GENERAL_CHAT_GCP_CACHE_ROOT=/tmp/openbench-gcs-cache

# Direct uploads use this path for large files. Multipart remains for small files only.
GENERAL_CHAT_MULTIPART_UPLOAD_MAX_BYTES=26214400
GENERAL_CHAT_GCP_MAX_SOURCE_BYTES=262144000
GENERAL_CHAT_GCP_CHUNK_SIZE=1000
GENERAL_CHAT_GCP_CHUNK_OVERLAP=200

# Cloud SQL for PostgreSQL.
# For private IP or Auth Proxy sidecar, use the appropriate host/port visible to the VM.
GENERAL_CHAT_DATABASE_URL=postgresql://openbench:CHANGE_ME@127.0.0.1:5432/openbench

# Pub/Sub subscription fed by Cloud Storage OBJECT_FINALIZE notifications.
# Use the full subscription path:
# projects/PROJECT_ID/subscriptions/openbench-worker-file-processing
GENERAL_CHAT_GCP_PUBSUB_SUBSCRIPTION=

# Optional runtime defaults. docker-compose.gce.yml already supplies these values.
# Keep them here only when you want to override the Compose defaults.
GENERAL_CHAT_STORAGE_ROOT=/app-data/openbench
GENERAL_CHAT_UPLOAD_DIR=/general-chat/uploads
GENERAL_CHAT_DOWNLOAD_DIR=/general-chat/downloads

# Optional all-MCP defaults. docker-compose.gce.yml already supplies these values.
GENERAL_CHAT_SEED_ALL_MCP=1
GENERAL_CHAT_MCP_SANDBOX=/general-chat/mcp-sandbox
GENERAL_CHAT_IMAGE_SEARCH_CONTAINER_UPLOAD_ROOT=/general-chat/uploads
GENERAL_CHAT_IMAGE_SEARCH_PREVIEW_DIR=/general-chat/image-search/data/previews
IMAGE_SEARCH_MCP_DATA_PATH=/app-data/image-search/data
IMAGE_SEARCH_MCP_MODELS_PATH=/app-data/image-search/models
IMAGE_SEARCH_MCP_UPLOADS_PATH=/app-data/uploads
IMAGE_SEARCH_MCP_HF_CACHE_PATH=/app-data/huggingface
SAM_SEGMENTATION_MCP_UPLOADS_PATH=/app-data/uploads
SAM_SEGMENTATION_MCP_DEBUG_PATH=/app-data/uploads/_sam_debug
OPENBENCH_MCP_DOCKER_PROFILE=openbench

OPENBENCH_IMAGE=openbench-general-chat:latest
OPENBENCH_API_PORT=8080
